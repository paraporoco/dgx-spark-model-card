// Phase 4.2 — update resilience for the dgx-model-card dashboard injection.
//
// The card is injected into the DGX Dashboard's DOM at runtime. NVIDIA's
// package is never modified, so an upgrade can never break the dashboard —
// but it can move or rename the card grid, in which case the card silently
// stops appearing. This hook prints a reminder whenever dgx-dashboard is
// touched by apt, so the anchor gets re-verified instead of quietly rotting.
//
// Verification after an upgrade:
//   1. open http://localhost:11000, sign in, confirm the Local models card renders
//   2. if it does not:  google-chrome --headless=new --no-sandbox \
//        --virtual-time-budget=8000 --dump-dom http://127.0.0.1:11000/ \
//        | grep -o 'class="flex gap-4[^"]*"'
//      then update findGrid() in /opt/local/dgx-model-card/web/card.js
//
// Remove this file to disable the reminder.

DPkg::Post-Invoke {
  "if dpkg-query -W -f='${Version}' dgx-dashboard 2>/dev/null | grep -qv '^0\\.29\\.2-2$'; then echo ''; echo '  >> dgx-dashboard version changed. Re-verify the Local models card renders'; echo '     (see /etc/apt/apt.conf.d/99-dgx-model-card-apt-notice), then update the'; echo '     pinned version in that file.'; echo ''; fi || true";
};
